# Names only. Copy to .env.local (chmod 600) and fill in locally. Never commit real values.
DEMO_MODE=synthetic
ALLOW_EXTERNAL_ACTIONS=false

# NVIDIA (build.nvidia.com): Nemotron 3 Ultra for plans, Lightning for the front door
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_PLAN_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_ROUTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DAILY_TOKENS=2000000
MODEL_TIMEOUT_MS=300000
ROUTER_MAX_TOKENS=600
PLAN_MAX_TOKENS=16000
# on (default) lets Ultra reason before writing plans; off is faster but less careful
PLAN_THINKING=on
FINANCE_PERIOD=2026-09

# Optional independent reviewer (xAI Grok); leave empty to skip
XAI_API_KEY=
XAI_MODEL=

# Zetaris (local Docker). The helper scripts in ~/getting-started document these.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Supabase: local stack values come from `npm run db:status`; cloud values from the demo project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (demo numbers only, dedicated API key; never the business's existing lines)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_OWNER_ASSISTANT=
TWILIO_FROM_FINANCE_ASSISTANT=
TWILIO_FROM_ONLINE_ASSISTANT=
# The exact public URL set on the Twilio numbers (Twilio signs it): <supabase-url>/functions/v1/inbound
TWILIO_WEBHOOK_URL=

# Real demo phones (personal data: .env.local only), registered by scripts/register-demo-phones.ts
DEMO_OWNER_PHONE=
DEMO_OWNER_NAME=
DEMO_FINANCE_PHONE=
DEMO_FINANCE_NAME=

# Printing (optional; dry-run when empty)
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_OWNER=
PRINTNODE_PRINTER_FINANCE=

# Meterless engines (fetched by scripts/setup-meterless.sh)
METERLESS_DIR=.local/meterless
