# Names only. Copy to .env.local (chmod 600) and fill in locally. Never commit real values.
DEMO_MODE=synthetic
ALLOW_EXTERNAL_ACTIONS=false

# NVIDIA (build.nvidia.com): Nemotron 3 Ultra for plans, Lightning for the front door
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_PLAN_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_ROUTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DAILY_TOKENS=2000000
MODEL_TIMEOUT_MS=300000
ROUTER_MAX_TOKENS=600
PLAN_MAX_TOKENS=16000
# on (default) lets Ultra reason before writing plans; off is faster but less careful
PLAN_THINKING=on
# The period plans are for. Unset: 2026-10-mtd when the data serves it, else its latest period (design 4g).
# FINANCE_PERIOD=2026-10-mtd

# Optional independent reviewer (xAI Grok); leave empty to skip
XAI_API_KEY=
XAI_MODEL=

# Zetaris (local Docker). The helper scripts in ~/getting-started document these.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Data version: 2 reads the 21 synthetic sources in 7 Lightning databases (what the deployed demo runs); 1 is the original single finance view.
FAHQ_DATA_VERSION=2

# Supabase: local stack values come from `npm run db:status`; cloud values from the demo project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (demo numbers only, dedicated API key; never the business's existing lines)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_OWNER_ASSISTANT=
TWILIO_FROM_FINANCE_ASSISTANT=
TWILIO_FROM_ONLINE_ASSISTANT=
# The exact public URL set on the Twilio numbers (Twilio signs it): <supabase-url>/functions/v1/inbound
TWILIO_WEBHOOK_URL=

# Real demo phones (personal data: .env.local only), registered by scripts/register-demo-phones.ts
DEMO_OWNER_PHONE=
DEMO_OWNER_NAME=
DEMO_FINANCE_PHONE=
DEMO_FINANCE_NAME=

# Printing (optional; dry-run when empty). One printer per head: a report prints on its head's printer, or is skipped with a reason.
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_OWNER=
PRINTNODE_PRINTER_FINANCE=
PRINTNODE_PRINTER_ONLINE=
PRINTNODE_PRINTER_SALON=

# Report email through Postmark (optional). Without the token or the sender, a report email is skipped with a plain reason.
# The Postmark server token for the report emails (a secret: .env.local only).
POSTMARK_HQ_SERVER_TOKEN=
# The sender address the report emails come from (a Postmark sender signature).
POSTMARK_HQ_FROM=
# The ONE address every report email goes to until real data is connected; each is labeled "For <head>". Empty: report emails are skipped.
HQ_REPORT_TO=

# The Admin console (npm run console) listens on 127.0.0.1 only. Its address: http://127.0.0.1:5180, or this port.
# CONSOLE_PORT=5180

# Meterless engines (fetched by scripts/setup-meterless.sh)
METERLESS_DIR=.local/meterless

# The primary path, as deployed for the demo: every model call goes through Meterless Nightshift (its Meterless
# Runtime), which calls NVIDIA with the key set up inside Nightshift. nvidia calls NVIDIA directly with NEMOTRON_API_KEY.
# Unset, the code uses nvidia.
MODEL_PROVIDER=meterless
# The safety screen's provider. Keep nvidia: Nightshift does not serve the content-safety model, and a guard that
# inherited meterless would fail every free text closed. It uses NEMOTRON_API_KEY above.
GUARD_PROVIDER=nvidia
# Where the Meterless Runtime listens (host:port). On the same machine Nightshift serves 127.0.0.1:8088; from WSL, use
# the address and port scripts/nightshift-bridge.mjs listens on (see the README).
METERLESS_BASE_URL=127.0.0.1:8088
# Path to the proxy-token file Nightshift writes. The token is read from it and never printed (or set METERLESS_TOKEN).
METERLESS_TOKEN_FILE=
