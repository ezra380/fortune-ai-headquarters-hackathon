{
  "name": "fortune-ai-headquarters",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "worker": "tsx apps/worker/src/main.ts",
    "console": "tsx apps/console/src/server.ts",
    "mcp": "tsx packages/codemode/src/serve.ts",
    "zetaris:setup": "tsx scripts/zetaris-setup.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "supabase@2.122.0": true
  }
}
